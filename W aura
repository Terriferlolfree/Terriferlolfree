function glow.register(obj)
    table.insert(glow.registry, obj)
end

function glow.setcolor(newcolor)
    glow.currentcolor = newcolor
    for i = 1, #glow.registry do
        local g = glow.registry[i]
        if g and g:IsA("ImageLabel") then
            g.ImageColor3 = newcolor
        end
    end
end

function glow.create(target)
    local glowlayer = Instance.new("ImageLabel")
    glowlayer.Name = "glowlayer"
    glowlayer.Parent = target
    glowlayer.BackgroundTransparency = 1
    glowlayer.BorderSizePixel = 0
    glowlayer.Image = "rbxassetid://18245826428"
    glowlayer.ImageColor3 = glow.currentcolor
    glowlayer.ImageTransparency = 0.8
    glowlayer.ScaleType = Enum.ScaleType.Slice
    glowlayer.SliceCenter = Rect.new(Vector2.new(21,21), Vector2.new(79,79))
    glowlayer.Size = UDim2.new(1, 40, 1, 40)
    glowlayer.Position = UDim2.new(0, -20, 0, -20)
    glowlayer.ZIndex = math.max(1, target.ZIndex - 1)
    glow.register(glowlayer)
    return glowlayer
end

