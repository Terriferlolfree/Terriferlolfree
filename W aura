local function buildComboPopup(box, items, isMulti, getState, onPick)
    closeAllPopups()
    local ITEM_H = 18
    local abs, sz = box.AbsolutePosition, box.AbsoluteSize
    local targetHeight = #items * ITEM_H + 4

    local pop = new("Frame", {
        Name = "ComboDropdown",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(abs.X, abs.Y + sz.Y + 2),
        Size = UDim2.fromOffset(sz.X, 0),
        ClipsDescendants = true,
        ZIndex = 501
    }, popupLayer)

    local _, pfill = framedBox(pop, THEME.OuterBorder, THEME.ComboInner, THEME.ComboFill, {ZIndex = 501})

    local scroll = new("ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 2),
        Size = UDim2.new(1, 0, 1, -4),
        CanvasSize = UDim2.fromOffset(0, #items * ITEM_H),
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = THEME.Accent,
        ZIndex = 502
    }, pfill)

    for i, it in ipairs(items) do
        local ib = new("TextButton", {
            Text = "",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, (i - 1) * ITEM_H),
            Size = UDim2.new(1, 0, 0, ITEM_H),
            ClipsDescendants = true,
            ZIndex = 503
        }, scroll)

        local hoverIndicator = new("Frame", {
            BackgroundColor3 = THEME.Accent,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(0, 2, 1, 0),
            BackgroundTransparency = 1,
            ZIndex = 504
        }, ib)

        local sel = getState(i)
        local il = outlined(ib, (sel and "• " or "  ") .. it, sel and THEME.ComboSelected or THEME.TextInactive, {
            Position = UDim2.fromOffset(6, 0),
            Size = UDim2.new(1, -8, 1, 0),
            ZIndex = 504
        })

        ib.MouseEnter:Connect(function()
            tween(hoverIndicator, 0.1, {BackgroundTransparency = 0}):Play()
            if not getState(i) then tween(il, 0.1, {TextColor3 = THEME.TextActive}):Play() end
        end)
        ib.MouseLeave:Connect(function()
            tween(hoverIndicator, 0.1, {BackgroundTransparency = 1}):Play()
            if not getState(i) then tween(il, 0.1, {TextColor3 = THEME.TextInactive}):Play() end
        end)

        ib.MouseButton1Click:Connect(function()
            onPick(i)
            if isMulti then
                local s = getState(i)
                il.Text = (s and "• " or "  ") .. it
                il.TextColor3 = s and THEME.ComboSelected or THEME.TextInactive
            else
                closeAllPopups()
            end
        end)
    end

    tween(pop, 0.15, {Size = UDim2.fromOffset(sz.X, targetHeight)}):Play()

    local blocker = new("TextButton", {
        Name = "Blocker", BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Size = UDim2.fromScale(1, 1), ZIndex = 500,
    }, popupLayer)

    local function closeMe()
        blocker:Destroy()
        local tw = tween(pop, 0.12, {Size = UDim2.fromOffset(sz.X, 0)})
        tw:Play()
        tw.Completed:Connect(function()
            pop:Destroy()
        end)
    end

    blocker.MouseButton1Click:Connect(closeAllPopups)

    openPopups[#openPopups + 1] = closeMe
    return pop
end

