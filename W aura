local function makeKeybindBox(parent, key, mode, onKey, onMode)
    local BOX_W, BOX_H = 32, 12
    local box = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,0,0,1), Size = UDim2.fromOffset(BOX_W, BOX_H), ZIndex = 4}, parent)
    local _, bFill = framedBox(box, THEME.OuterBorder, THEME.InnerBorder, THEME.ChildFill, {ZIndex = 4})
    local lbl = outlined(bFill, keyName(key), THEME.TextInactive, {Size = UDim2.fromScale(1,1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5, TextSize = 11})

    local listening = false
    box.MouseButton1Click:Connect(function()
        listening = true; lbl.Text = "..."; lbl.TextColor3 = THEME.Accent
        local conn
        conn = UIS.InputBegan:Connect(function(inp, gp)
            if not listening then return end
            local k
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                if inp.KeyCode == Enum.KeyCode.Escape then k = nil else k = inp.KeyCode end
            elseif inp.UserInputType == Enum.UserInputType.MouseButton1
                or inp.UserInputType == Enum.UserInputType.MouseButton2
                or inp.UserInputType == Enum.UserInputType.MouseButton3 then
                k = inp.UserInputType
            else return end
            listening = false; conn:Disconnect()
            key = k; lbl.Text = keyName(k); lbl.TextColor3 = THEME.TextInactive
            if onKey then onKey(k) end
        end)
    end)
    box.MouseButton2Click:Connect(function()
        closeAllPopups()
        local abs = bFill.AbsolutePosition
        local modes = {"toggle", "hold", "always"}
        local pop = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(abs.X - 28, abs.Y + 13), Size = UDim2.fromOffset(60, #modes*16), ZIndex = 501}, popupLayer)
        local _, pf = framedBox(pop, THEME.OuterBorder, THEME.ComboInner, THEME.ComboFill, {ZIndex = 501})
        for i, m in ipairs(modes) do
            local mb = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.fromOffset(0,(i-1)*16), Size = UDim2.fromOffset(60,16), ZIndex = 502}, pf)
            local ml = outlined(mb, m, (mode == i) and THEME.Accent or THEME.TextInactive, {Size = UDim2.fromScale(1,1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 503})
            mb.MouseButton1Click:Connect(function() mode = i; if onMode then onMode(i, m) end closeAllPopups() end)
        end
        local blocker = new("TextButton", {
            Name = "Blocker", BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
            Size = UDim2.fromScale(1, 1), ZIndex = 500,
        }, popupLayer)
        blocker.MouseButton1Click:Connect(closeAllPopups)
        openPopups[#openPopups+1] = function() blocker:Destroy(); pop:Destroy() end
    end)
    return box, function() return key, mode end
end

